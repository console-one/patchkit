{
  "name": "@console-one/patchkit",
  "version": "0.3.1",
  "description": "Polymorphic DataType interface for version control over arbitrary data (Object, Array, Set, Source/text) with a live-mutation Ledger on top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/console-one/patchkit.git"
  },
  "bugs": {
    "url": "https://github.com/console-one/patchkit/issues"
  },
  "homepage": "https://github.com/console-one/patchkit#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "version-control",
    "patch",
    "diff",
    "collate",
    "datatype",
    "type-system",
    "history",
    "rollback",
    "ledger",
    "undo"
  ],
  "author": "Andrew Chalmers",
  "license": "MIT",
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5"
  }
}
